{{- $authorEmail := site.Params.author.email -}}
{{- $authorName := site.Params.author.name -}}

{{- $pages := where site.RegularPages "Params.private" "ne" true -}}
{{- $pages = where $pages "Params.rss_ignore" "ne" true -}}

{{- $allImages := slice -}}
{{- range $pages -}}
  {{- $page := . -}}
  {{- range where (.Resources.ByType "image") "Params.hidden" "ne" true -}}
    {{- $imgPath := printf "content/%s%s" $page.File.Dir .Name -}}
    {{- $date := (os.Stat $imgPath).ModTime -}}
    {{- $title := "" -}}
    {{- with .Meta }}{{- with .Exif.ImageDescription }}{{- $title = . -}}{{- end -}}{{- end -}}
    {{- if ne .Title .Name }}{{- $title = .Title -}}{{- end -}}
    {{- $allImages = $allImages | append (dict "image" . "page" $page "date" $date "title" $title) -}}
  {{- end -}}
{{- end -}}
{{- $allImages = sort $allImages "date" "desc" -}}

{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $allImages = $allImages | first $limit -}}
{{- end -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{.}} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.LanguageCode }}</language>{{ with site.Params.author.email }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{ end }}{{ with index $allImages 0 }}
    <lastBuildDate>{{ .date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $allImages }}
    <item>
      <title>{{ with .title }}{{ . }}{{ else }}{{ .page.Title }}{{ end }}</title>
      <link>{{ .page.Permalink }}</link>
      <pubDate>{{ .date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      <guid>{{ .page.Permalink }}#{{ .image.Name | urlize }}</guid>
      {{- $thumbnail := .image.Filter (slice images.AutoOrient (images.Process "fill 900x600")) -}}
      {{- $borderSize := site.Params.gallery.borderSize | default 0 | int -}}
      {{- if gt $borderSize 0 -}}
        {{- $thumbBorder := div (mul $borderSize $thumbnail.Width) 1600 -}}
        {{- $thumbnail = $thumbnail.Filter (images.Padding $thumbBorder (site.Params.gallery.borderColor | default "#ffffff")) -}}
      {{- end }}
      <media:content url="{{ $thumbnail.Permalink }}" type="image/jpeg"/>
      <description>
        &lt;img src=&quot;{{ $thumbnail.Permalink }}&quot; /&gt;
        &lt;p&gt;{{ .page.Title }}&lt;/p&gt;
      </description>
    </item>
    {{- end }}
  </channel>
</rss>
