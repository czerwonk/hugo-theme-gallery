{{- $authorEmail := site.Params.author.email -}}
{{- $authorName := site.Params.author.name -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}

{{- $pages := where site.RegularPages "Params.private" "ne" true -}}
{{- $pages = where $pages "Params.rss_ignore" "ne" true -}}
{{- $images := partial "rss-collect-images.html" (dict "pages" $pages "limit" $limit) -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.LanguageCode }}</language>{{ with site.Params.author.email }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{ end }}{{ with index $images 0 }}
    <lastBuildDate>{{ .date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{ partial "rss-image-items.html" (dict "images" $images "authorEmail" $authorEmail "authorName" $authorName) }}
  </channel>
</rss>
